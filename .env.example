# 环境变量示例（复制为 .env 并填写真实值）
DATABASE_URL="postgresql://devshowcase:YOUR_PASSWORD@localhost:5432/devshowcase?schema=public"
NEXTAUTH_URL="https://jktac.top"
NEXTAUTH_SECRET="请生成随机长字符串"
ADMIN_USERNAME="admin"
# 支持明文或 bcrypt 哈希（node scripts/hash-password.mjs <密码>）
ADMIN_PASSWORD="请设置强密码"

# 反馈通知（可选，未配置则跳过）
NOTIFY_EMAIL_TO="admin@example.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="noreply@jktac.top"
WECHAT_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY"

# 备份（scripts/backup.mjs）
BACKUP_DIR="/root/dev-showcase/backups"
BACKUP_RETENTION_DAYS="7"
